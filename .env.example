# Universal Contact Launcher — Environment Configuration
# Copy this file to `.env.local` and fill in real values for production.

# ---------------------------------------------------------------------------
# Signaling server (WebSocket) used to exchange WebRTC offer/answer/ICE.
# This app ships with a client that connects to this URL. You must run the
# companion signaling server (see server/README.md) or point this at any
# WebSocket signaling service you operate.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8080

# ---------------------------------------------------------------------------
# TURN / STUN configuration. STUN is required for most networks; TURN is
# required for restrictive NATs (symmetric NAT, corporate firewalls).
# Provide comma-separated urls. Credentials for TURN should be kept server
# side and minted via a REST auth endpoint in production, but a static
# username/credential is supported for quick deployment.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302

# Example public TURN (replace with your own provider, e.g. Metered/OpenRelay/Twilio)
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# Production URL (no trailing slash). Used for canonical tags, sitemap.xml
# and robots.txt. Example: https://your-domain.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Google AdSense (monetization).
#
# Get these from YOUR AdSense account (https://adsense.google.com):
#   NEXT_PUBLIC_ADSENSE_CLIENT_ID  -> ca-pub-XXXXXXXXXXXXXXXX (16 digits)
#   NEXT_PUBLIC_ADSENSE_HOME_SLOT  -> the numeric data-ad-slot of your ad unit
#
# When these are absent or malformed, NO ad is shown and the site works
# normally. Never commit real values that you consider secret to a public repo.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_HOME_SLOT=

